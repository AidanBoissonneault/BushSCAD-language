{
    "name":  "@bushscad/model-analysis",
    "version":  "0.1.0-beta.1",
    "type":  "module",
    "bin":  {
                "bushscad-analyze-model":  "./dist/cli.js"
            },
    "exports":  {
                    ".":  "./src/index.ts"
                },
    "scripts":  {
                    "build":  "tsc --noEmit \u0026\u0026 esbuild src/cli/cli.ts --bundle --platform=node --target=node18 --format=esm --outfile=dist/cli.js --sourcemap --external:opencascade.js --external:opencascade.js/* --external:playwright --external:playwright-core --alias:@bushscad/compiler/paths=../compiler/src/core/paths.ts --alias:@bushscad/compiler=../compiler/src/index.ts --alias:@bushscad/compiler/node=../compiler/src/platform/node/node.ts --alias:@bushscad/evaluator=../evaluator/src/index.ts --alias:@bushscad/ir=../ir/src/index.ts --alias:@bushscad/occt-bridge=../occt-bridge/src/index.ts --alias:@bushscad/occt-bridge/opencascade-types=../occt-bridge/src/types/opencascade-types.ts --alias:@bushscad/parser=../parser/src/index.ts --alias:@bushscad/resolver=../resolver/src/index.ts",
                    "typecheck":  "tsc --noEmit \u0026\u0026 tsc --noEmit -p tsconfig.test.json",
                    "test":  "vitest run"
                },
    "dependencies":  {
                         "@bushscad/compiler":  "^0.1.0-beta.1",
                         "@bushscad/ir":  "^0.1.0-beta.1"
                     },
    "devDependencies":  {
                            "esbuild":  "^0.28.0",
                            "playwright":  "^1.57.0",
                            "typescript":  "^5.4.0",
                            "vitest":  "^4.1.5"
                        },
    "license":  "Apache-2.0",
    "description":  "Model analysis command-line and reporting tools for BushSCAD compiler output.",
    "homepage":  "https://bushscad.byaidan.com/",
    "repository":  {
                       "type":  "git",
                       "url":  "https://github.com/AidanBoissonneault/BushSCAD-Language.git",
                       "directory":  "packages/model-analysis"
                   },
    "bugs":  {
                 "url":  "https://github.com/AidanBoissonneault/BushSCAD-Language/issues"
             },
    "publishConfig":  {
                          "access":  "public",
                          "registry":  "https://registry.npmjs.org/"
                      },
    "files":  [
                  "src/**",
                  "dist/**",
                  "assets/**",
                  "LICENSE",
                  "README.md"
              ]
}
