    {
      "id": "12-imported-assets",
      "title": "Imported shapes and fonts",
      "description": "A STEP model and TrueType font pass through the asset pipeline; the shape is wrapped by a ref, repaired, anchored, and placed.",
      "file": "12_imported_assets.bscd",
      "capabilities": [
        "assets.shape-import",
        "assets.font-import",
        "detail.heal",
        "detail.defeature"
      ],
      "expectations": {
        "minMeshes": 1,
        "minTriangles": 40,
        "requiredOperations": ["importShape", "heal", "defeature"],
        "maxWarnings": 20,
        "allowBoundaryEdges": true,
        "allowDisconnectedComponents": true
      }
    },
    {
      "id": "13-module-library",
      "title": "Exported module library",
      "description": "Exported values, functions, and refs remain independently renderable and reusable.",
      "file": "13_module_library.bscd",
      "capabilities": [],
