// M1-M7 Test 02: all five non-word sketch primitives — rect, circle, roundrect,
//                triangle, polygon — each extruded , @a base plate
base_unit = mm;

var base_w = 130;
var base_h = 60;
var pad_h  = 4;

part shapes {
    sketch base = rect(base_w, base_h);
    obj base = extrude(base, pad_h);

    // rect pillar
    sketch r = rect(18, 14);
    obj r = extrude(r, 10 , @base.top(12, 1));

    // circle pillar
    sketch c = circle(14);
    obj c = extrude(c, 10 , @base.top(x: 40, y: 20));

    // roundrect pillar
    sketch rr = roundrect(22, 12, r: 4);
    obj rr = extrude(rr, 10 , @base.top(x: 68, y: 12));

    // triangle pillar
    sketch tri = triangle(18, 14);
    obj tri = extrude(tri, 10 , @base.top(x: 98, y: -10));

    // arbitrary polygon pillar
    sketch poly = polygon([(0,0),(20,0),(24,12),(10,18),(0,12)]);
    obj poly = extrude(poly, 10 , @base.top(x: 12, y: 40));

    fillet(@base.top.edges, 1);
    chamfer(@base.bottom.edges, 0.5);
    fillet(@r.top.edges, 1);
    fillet(@c.top.edges, 1);
    fillet(@rr.top.edges, 1);
}
