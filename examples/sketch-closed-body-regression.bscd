// Closed-region and perimeter regression owned by the automated test suite.
sketch drawn_sketch = path(
  origin((0, 0)),
  bottom = line((0, 0), (50, 0)),
  right = line((50, -30)),
  top = line((0, -30)),
  left = close(),
  circle_1_q1 = arc((64.082, 0), (49.792, 14.290), 14.290, ccw),
  circle_1_q2 = arc((35.501, 0), 14.290, ccw),
  circle_1_q3 = arc((49.792, -14.290), 14.290, ccw),
  circle_1_q4 = arc((64.082, 0), 14.290, ccw),
  construction circle_1_radius = line((49.792, 0), (64.082, 0)),
  circle_2_q1 = arc((88.436, -14.290), (49.792, 27.066), 38.644, ccw),
  circle_2_q2 = arc((11.147, -14.290), 38.644, ccw),
  circle_2_q3 = arc((49.792, -52.934), 38.644, ccw),
  circle_2_q4 = arc((88.436, -14.290), 38.644, ccw),
  construction circle_2_radius = line((49.792, -14.290), (88.436, -14.290)),
  body_1 = closed((25, -12.500)),
  ignoreClosed((49.896, -1.849)),
  ignoreClosed((63.838, 1.849)),
  constraint(bottom.end, distance, origin.y_axis, 50, at: (30, -5)),
  constraint(right.end, distance, origin.x_axis, 30, at: (74.625, -4.750)),
  constraint(circle_2_q3.end, distance, circle_2_q1.end, 80, at: (45, -68.644))
);

obj test = extrude(drawn_sketch, 10);
